<?php
// getWeather.php - robust proxy:
// 1) try OneCall (if available)
// 2) if OneCall fails (e.g. 401) fallback to /forecast (5-day / 3-hour) and synthesize hourly/daily
// Returns: { currentWeather: {...}, forecast: { hourly: [...], daily: [...] }, oc_error?: "..." }

ini_set('display_errors', 1);
ini_set('display_startup_errors', 1);
error_reporting(E_ALL);

$apiKey = 'fd87d34ce3166cfc24bcbb19359342fa'; // keep private
$baseWeather = 'https://api.openweathermap.org/data/2.5/weather';
$baseOneCall = 'https://api.openweathermap.org/data/2.5/onecall';
$baseForecast = 'https://api.openweathermap.org/data/2.5/forecast'; // 3-hour forecast (free)

header('Access-Control-Allow-Origin: *');
header('Access-Control-Allow-Methods: GET');
header('Content-Type: application/json; charset=UTF-8');

$city = isset($_GET['city']) ? trim($_GET['city']) : '';
$units = isset($_GET['units']) ? $_GET['units'] : 'metric';

if ($city === '') {
    http_response_code(400);
    echo json_encode(['cod'=>400,'message'=>'Missing city parameter.']);
    exit;
}

/* 1) Get current weather (to obtain coordinates) */
$wurl = $baseWeather . '?q=' . urlencode($city) . '&appid=' . $apiKey . '&units=' . $units;
$ch = curl_init($wurl);
curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
curl_setopt($ch, CURLOPT_TIMEOUT, 10);
$wres = curl_exec($ch);
if ($wres === false) {
    $err = curl_error($ch);
    curl_close($ch);
    http_response_code(500);
    echo json_encode(['cod'=>500,'message'=>'Failed to fetch current weather.','curl_error'=>$err]);
    exit;
}
$winfo = json_decode($wres, true);
$status = curl_getinfo($ch, CURLINFO_HTTP_CODE);

if ($status !== 200) {
    http_response_code($status);
    echo $wres;
    exit;
}

/* Extract coords */
$lat = isset($winfo['coord']['lat']) ? $winfo['coord']['lat'] : null;
$lon = isset($winfo['coord']['lon']) ? $winfo['coord']['lon'] : null;

/* Prepare response skeleton */
$response = [
    'currentWeather' => $winfo,
    'forecast' => null
];

$oc_error = null;

/* 2) Try OneCall first (best if key works) */
if ($lat !== null && $lon !== null) {
    $onecallUrl = $baseOneCall . '?lat=' . $lat . '&lon=' . $lon . '&exclude=minutely,alerts&units=' . $units . '&appid=' . $apiKey;
    $oc = curl_init($onecallUrl);
    curl_setopt($oc, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($oc, CURLOPT_TIMEOUT, 10);
    $ocres = curl_exec($oc);

    if ($ocres === false) {
        $oc_error = 'OneCall cURL error: ' . curl_error($oc);
    } else {
        $oc_status = curl_getinfo($oc, CURLINFO_HTTP_CODE);
        if ($oc_status === 200) {
            $ocinfo = json_decode($ocres, true);
            if ($ocinfo !== null) {
                $response['forecast'] = $ocinfo; // pass through (hourly/daily available)
            } else {
                $oc_error = 'OneCall JSON decode failed';
            }
        } else {
            $oc_error = 'OneCall HTTP ' . $oc_status . ' - ' . $ocres;
        }
    }
    if (is_resource($oc)) curl_close($oc);
}

/* 3) If OneCall failed (forecast still null), fallback to 5-day /forecast (3-hour) */
if ($response['forecast'] === null) {
    // call /forecast
    $furl = $baseForecast . '?lat=' . $lat . '&lon=' . $lon . '&appid=' . $apiKey . '&units=' . $units;
    // Note: /forecast also supports ?q=city, but using coords is more reliable
    $fc = curl_init($furl);
    curl_setopt($fc, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($fc, CURLOPT_TIMEOUT, 10);
    $fcres = curl_exec($fc);

    if ($fcres === false) {
        $fc_err = curl_error($fc);
        // return currentWeather but include oc_error + fc error
        $response['oc_error'] = $oc_error ?? ('Forecast cURL error: ' . $fc_err);
        if (is_resource($fc)) curl_close($fc);
        if (is_resource($ch)) curl_close($ch);
        echo json_encode($response, JSON_UNESCAPED_SLASHES|JSON_PRETTY_PRINT);
        exit;
    } else {
        $fc_status = curl_getinfo($fc, CURLINFO_HTTP_CODE);
        if ($fc_status !== 200) {
            $response['oc_error'] = $oc_error ?? ('Forecast HTTP ' . $fc_status . ' - ' . $fcres);
            if (is_resource($fc)) curl_close($fc);
            if (is_resource($ch)) curl_close($ch);
            echo json_encode($response, JSON_UNESCAPED_SLASHES|JSON_PRETTY_PRINT);
            exit;
        } else {
            $finfo = json_decode($fcres, true);
            if ($finfo === null) {
                $response['oc_error'] = $oc_error ?? 'Forecast JSON decode failed';
            } else {
                // Build forecast.hourly (24 items) and forecast.daily (7 items) from finfo.list (3-hour samples)
                $hourly = [];
                $nowTs = time();
                // finfo.list contains items with dt (timestamp) and main.temp
                foreach ($finfo['list'] as $item) {
                    // include items upto next 24 hours
                    if ($item['dt'] <= $nowTs + 24*3600) {
                        $hourly[] = ['dt' => $item['dt'], 'temp' => $item['main']['temp']];
                    }
                }
                // if hourly is empty (rare), create a fallback from current
                if (count($hourly) === 0) {
                    $hourly[] = ['dt' => $nowTs, 'temp' => $winfo['main']['temp']];
                }

                // Build daily: aggregate by date for up to 7 days using temp from 3hr samples
                $daily_map = [];
                foreach ($finfo['list'] as $item) {
                    $d = gmdate('Y-m-d', $item['dt']);
                    if (!isset($daily_map[$d])) $daily_map[$d] = ['max' => -PHP_FLOAT_MAX, 'min' => PHP_FLOAT_MAX, 'dt' => $item['dt']];
                    $t = $item['main']['temp'];
                    if ($t > $daily_map[$d]['max']) $daily_map[$d]['max'] = $t;
                    if ($t < $daily_map[$d]['min']) $daily_map[$d]['min'] = $t;
                }
                // convert to array sorted by date, limit to 7
                $daily = [];
                $count = 0;
                foreach ($daily_map as $date => $vals) {
                    if ($count >= 7) break;
                    $daily[] = [
                        'dt' => $vals['dt'],
                        'temp' => ['max' => round($vals['max'], 2), 'min' => round($vals['min'], 2)]
                    ];
                    $count++;
                }

                // Attach produced forecast in a compact structure used by frontend
                $response['forecast'] = [
                    'hourly' => $hourly,
                    'daily' => $daily,
                    // include original raw forecast for debugging if needed
                    'raw_forecast_source' => $finfo
                ];
            }
            if (is_resource($fc)) curl_close($fc);
        }
    }
}

/* finalize */
if ($oc_error !== null && !isset($response['oc_error'])) $response['oc_error'] = $oc_error;
if (is_resource($ch)) curl_close($ch);

echo json_encode($response, JSON_UNESCAPED_SLASHES|JSON_PRETTY_PRINT);
